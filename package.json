{
  "name": "kanby",
  "version": "0.1.0",
  "description": "An agent-native kanban board for small software teams",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmazingAng/kanby.git"
  },
  "homepage": "https://kanby.dev",
  "bugs": {
    "url": "https://github.com/AmazingAng/kanby/issues"
  },
  "keywords": [
    "kanban",
    "coding-agent",
    "cloudflare-workers",
    "github-app"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:xapi-workers": "NEXT_PUBLIC_BASE_PATH=/w/702a5b1647a3/preview vinext build && NEXT_PUBLIC_BASE_PATH=/w/702a5b1647a3/preview node tools/package-xapi-worker.mjs",
    "postbuild": "node tools/add-worker-schedule.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy:cloudflare": "vinext build && wrangler deploy --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutations": "node tools/mutants.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md .github app components/gateway-app.tsx components/home-page.tsx components/kanban-app.tsx components/kanby-shell.tsx components/settings-app.tsx db docs drizzle lib proxy.ts packages tests tools vite.config.ts vitest.config.ts package.json",
    "gauntlet": "bash tools/gauntlet.sh",
    "cli": "kanby",
    "cli:pack:check": "npm pack --workspace @kanby/cli --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "^0.31.10",
    "fast-check": "4.9.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  },
  "type": "module"
}
