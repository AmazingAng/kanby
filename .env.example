# GitHub OAuth App credentials. Keep the secret server-side.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App repository integration. Keep the private key and webhook secret server-side.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Exact production origin; no path or trailing slash.
PUBLIC_APP_ORIGIN=https://kanby.dev

# Optional comma-separated GitHub usernames or verified emails for direct collaborators.
ALLOWED_GITHUB_LOGINS=

# Optional comma-separated GitHub organization names. Active members are allowed.
ALLOWED_GITHUB_ORGS=

# Optional comma-separated org/team-slug values for team-scoped access.
ALLOWED_GITHUB_TEAMS=

# Used only while building for your own Cloudflare account.
CF_D1_DATABASE_ID=
CF_D1_DATABASE_NAME=kanby-db
CF_R2_BUCKET_NAME=kanby-attachments
CF_WORKER_NAME=kanby
CF_CUSTOM_DOMAIN=kanby.dev
